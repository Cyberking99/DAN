// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  address   String   @unique
  createdAt DateTime @default(now())

  submissions  Submission[]  @relation("UserSubmissions")
  certificates Certificate[] @relation("UserCertificates")
}

model Submission {
  id            String   @id @default(uuid())
  title         String
  author        String
  abstract      String?
  ipfs_cid      String
  score         Float?
  status        String   @default("Under Review")
  dateSubmitted DateTime @default(now())

  userId String
  user   User   @relation("UserSubmissions", fields: [userId], references: [id])

  review      Review?
  certificate Certificate?
}

model Review {
  id              String   @id @default(uuid())
  submissionId    String   @unique
  ai_agent        String   @default("GPT-4o")
  abstract        String?
  score           Float
  methodology     Float?
  novelty         Float?
  clarity         Float?
  reproducibility Float?
  feedback        Json?
  dateReviewed    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id])
}

model Certificate {
  id           String   @id @default(uuid())
  submissionId String   @unique
  txHash       String
  tokenUri     String
  dateMinted   DateTime @default(now())

  userId String
  user   User   @relation("UserCertificates", fields: [userId], references: [id])

  submission Submission @relation(fields: [submissionId], references: [id])
}

model Nonce {
  id        String   @id @default(uuid())
  address   String   @unique
  value     String
  createdAt DateTime @default(now())
}